{
  "name": "vento-norte-health",
  "productName": "Vento Norte Health",
  "version": "0.1.0",
  "description": "Monitoramento da saúde de astronautas em missões espaciais. Protótipo do time Vento Norte UEA para o NASA Space Apps Challenge 2026.",
  "type": "module",
  "main": "out/main/index.js",
  "homepage": "./",
  "author": "Vento Norte UEA",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "npm run build && electron .",
    "test": "vitest",
    "mock:generate": "python tools/mock_data/generate.py",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "@fontsource/source-sans-3": "^5.1.0",
    "@tremor/react": "^3.18.7",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.ventonondesaude.app",
    "productName": "Vento Norte Health",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out",
      "resources/mock/**/*",
      "resources/icon.*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
