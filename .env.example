# Copie este arquivo para .env e preencha os valores reais.
# Nunca envie o arquivo .env para o repositório.

# Aplicação
APP_ENV=development
APP_PORT=3000
SECRET_KEY=troque_por_uma_chave_secreta

# Banco de dados
DATABASE_URL=postgresql://usuario:senha@localhost:5432/saude_astronautas

# Integração com sensores/dispositivos de monitoramento (opcional)
SENSOR_API_URL=
SENSOR_API_KEY=

# Alertas (opcional)
ALERT_EMAIL=